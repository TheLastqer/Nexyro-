local hopToken = 0
Appliers.AutoHop = function(value)
    Settings.AutoHop = value
    hopToken = hopToken + 1
    if value then
        local myToken = hopToken
        task.spawn(function()
            while Settings.AutoHop and hopToken == myToken do
                local remaining = Settings.HopInterval
                while remaining > 0 and Settings.AutoHop and hopToken == myToken do
                    task.wait(1)
                    remaining = remaining - 1
                end
                if Settings.AutoHop and hopToken == myToken then
                    hopServer()
                    task.wait(10)
                end
            end
        end)
    end
end
