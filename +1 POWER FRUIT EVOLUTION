local function readText(obj)
    if not obj then return "" end
    if obj:IsA("ValueBase") then return tostring(obj.Value) end
    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then return obj.Text end
    return ""
end

local function parseNumber(text)
    text = tostring(text):gsub(",", ""):upper()
    local num = tonumber(text:match("%d+%.?%d*"))
    if not num then return 0 end
    local suffix = text:match("%d%s*([KMBT])")
    local mult = {K = 1e3, M = 1e6, B = 1e9, T = 1e12}
    return num * (mult[suffix] or 1)
end

local function isFull()
    local ok, text = pcall(function()
        return readText(Player.PlayerGui.FusionUI.Hud.BottomLeft.Stat_Seeds.Content.Value)
    end)
    if not ok then return false end
    local cur, max = tostring(text):gsub(",", ""):match("(%d+)%s*/%s*(%d+)")
    cur, max = tonumber(cur), tonumber(max)
    return cur ~= nil and max ~= nil and max > 0 and cur >= max
end

