local function getObjCFrame(obj)
    if obj:IsA("BasePart") then return obj.CFrame end
    if obj:IsA("Model") then return obj:GetPivot() end
    local p = obj:FindFirstChildWhichIsA("BasePart", true)
    return p and p.CFrame
end

-- ---------- BUTTER-SMOOTH MOVEMENT (AlignPosition, no anchoring, no deaths) ----------
local partCache = {char = nil, parts = {}}
local function getCollidableParts(char)
    if partCache.char ~= char then
        partCache.char = char
        partCache.parts = {}
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                table.insert(partCache.parts, part)
            end
        end
    end
    return partCache.parts
end

local function smoothMove(cf, offset, speed)
    local root = getRoot()
    local char = Player.Character
    if not root or not char or not cf then return end
    local target = (cf + (offset or Vector3.new(0, 4, 0))).Position
    if (target - root.Position).Magnitude < 0.5 then return end

    local myCancel = moveCancel
    local parts = getCollidableParts(char)
    local noclipConn = RunService.Stepped:Connect(function()
        for i = 1, #parts do
            parts[i].CanCollide = false
        end
    end)

    local rotation = root.CFrame - root.CFrame.Position
    local moveSpeed = speed or MOVE_SPEED

    local attachment = root:FindFirstChild("SmoothMoveAttachment")
    if not attachment then
        attachment = Instance.new("Attachment")
        attachment.Name = "SmoothMoveAttachment"
        attachment.Parent = root
    end

    local alignPos = Instance.new("AlignPosition")
    alignPos.Mode = Enum.PositionAlignmentMode.OneAttachment
    alignPos.Attachment0 = attachment
    alignPos.Position = target
    alignPos.MaxForce = math.huge
    alignPos.MaxVelocity = moveSpeed
    alignPos.Responsiveness = 100
    alignPos.ApplyAtCenterOfMass = false
    alignPos.Parent = root

    local alignOrient = Instance.new("AlignOrientation")
    alignOrient.Mode = Enum.OrientationAlignmentMode.OneAttachment
    alignOrient.Attachment0 = attachment
    alignOrient.CFrame = rotation
    alignOrient.MaxTorque = math.huge
    alignOrient.Responsiveness = 100
    alignOrient.Parent = root

    local startT = os.clock()
    while myCancel == moveCancel and root.Parent and os.clock() - startT < 12 do
        if (root.Position - target).Magnitude < 2 then break end
        RunService.Heartbeat:Wait()
    end

    pcall(function() alignPos:Destroy() end)
    pcall(function() alignOrient:Destroy() end)
    noclipConn:Disconnect()
    for i = 1, #parts do
        if parts[i].Parent then parts[i].CanCollide = true end
    end
    if root.Parent then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

local function goToStage(stage)
    local islands = getIslands()
    local island = islands and islands:FindFirstChild("Island_Stage" .. stage)
    if not island then return nil end
    smoothMove(getObjCFrame(island), Vector3.new(0, 6, 0), MOVE_SPEED * 1.5)
    return island
end

local function isAlive(enemy)
    if not enemy or not enemy.Parent then return false end
    local hum = enemy:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return false end
    local hp = enemy:GetAttribute("Health")
    if type(hp) == "number" and hp <= 0 then return false end
    return true
end

local function getNearestEnemy(center, ignore)
    local folder = workspace:FindFirstChild("_LocalEnemies")
    if not folder then return nil end
    local best, bestDist
    for _, enemy in ipairs(folder:GetChildren()) do
        if not ignore[enemy] and isAlive(enemy) then
            local cf = getObjCFrame(enemy)
            if cf then
                local d = (cf.Position - center).Magnitude
                if d <= FarmRadius and (not bestDist or d < bestDist) then
                    best, bestDist = enemy, d
                end
            end
        end
    end
    return best
end

