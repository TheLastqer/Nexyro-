                tool = t
            end
        end
        if tool then tool:Activate() end
        VirtualUser:CaptureController()
        VirtualUser:ClickButton1(Vector2.new(0, 0))
    end)
end

local function killEnemy(enemy, token)
    local startT = os.clock()
    while farmActive(token) and isAlive(enemy) and os.clock() - startT < 15 do
        local root = getRoot()
        local cf = getObjCFrame(enemy)
        if root and cf and (root.Position - cf.Position).Magnitude > 8 then
            smoothMove(cf, Vector3.new(0, 3, 3))
        end
        attack()
        task.wait(0.15)
    end
    return not isAlive(enemy)
end

local function clearStage(stage, token)
    local island = goToStage(stage)
    if not island then
        notify("Auto Farm", "Island_Stage" .. stage .. " not found")
        return
    end
    local center = getObjCFrame(island).Position
    local skipped = {}
    local startT, emptyChecks = os.clock(), 0
    while farmActive(token) and os.clock() - startT < 120 do
        local enemy = getNearestEnemy(center, skipped)
        if enemy then
            emptyChecks = 0
            local cf = getObjCFrame(enemy)
            if cf then smoothMove(cf, Vector3.new(0, 3, 3)) end
            if not killEnemy(enemy, token) then
                skipped[enemy] = true
            end
            task.wait(0.15)
        else
            emptyChecks = emptyChecks + 1
            if emptyChecks >= 5 then break end
            task.wait(0.25)
        end
    end
end

local function getBestDrop(blacklist)
    local drops = workspace:FindFirstChild("_SeedDrops")
    if not drops then return nil end
    local best, bestPrice = nil, -1
    for _, drop in ipairs(drops:GetChildren()) do
        if not blacklist[drop] then
            local prompt = drop:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then
                local p = parseNumber(readText(drop:FindFirstChild("Price", true)))
                if p > bestPrice then best, bestPrice = drop, p end
            end
        end
    end
    return best
end

local function collectLoot(token)
    local blacklist = {}
    local idleStart
    while farmActive(token) and not isFull() do
        local drop = getBestDrop(blacklist)
        if not drop then
            idleStart = idleStart or os.clock()
            if os.clock() - idleStart > 3 then return end
            task.wait(0.3)
        else
            idleStart = nil
            local prompt = drop:FindFirstChildWhichIsA("ProximityPrompt", true)
            local part = (prompt and prompt.Parent:IsA("BasePart") and prompt.Parent)
                or drop:FindFirstChildWhichIsA("BasePart", true)
            if prompt and part then
                prompt.HoldDuration = 0
                prompt.RequiresLineOfSight = false
                prompt.MaxActivationDistance = 50
                smoothMove(part.CFrame, Vector3.new(0, 3, 0))
                for _ = 1, 4 do
                    if not farmActive(token) or not drop.Parent or isFull() then break end
                    if fireproximityprompt then
                        fireproximityprompt(prompt)
                    else
                        prompt:InputHoldBegin()
                        task.wait(0.05)
                        prompt:InputHoldEnd()
                    end
                    task.wait(LOOT_COOLDOWN)
                end
                if drop.Parent then blacklist[drop] = true end
            else
                blacklist[drop] = true
            end
        end
    end
end

local function farmLoop(token)
    while farmActive(token) do
        local ok, err = pcall(function()
            for stage = 1, Settings.FarmStage do
                if not farmActive(token) then return end
                clearStage(stage, token)
            end
            if farmActive(token) then collectLoot(token) end
            if farmActive(token) then
                EndRunRemote = EndRunRemote or RS:WaitForChild("_Net"):WaitForChild("EndRun")
                EndRunRemote:FireServer()
                task.wait(3)
            end
        end)
        if not ok then
            warn("AutoFarm error:", err)
            task.wait(1)
        end
    end
end

