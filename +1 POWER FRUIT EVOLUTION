ConfigTab:Button({
    Title = "Delete Config",
    Callback = function()
        if not SelectedConfig then
            notify("Config", "Select a config first.")
            return
        end
        local name = SelectedConfig
        pcall(function()
            if typeof(delfile) == "function" and isfile(configPath(name)) then
                delfile(configPath(name))
            end
        end)
        local index = table.find(ConfigNames, name)
        if index then table.remove(ConfigNames, index) end
