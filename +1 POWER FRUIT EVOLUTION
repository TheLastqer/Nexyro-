    Title = "Auto Load",
    Desc = "When enabled, the selected config loads automatically the next time you run the script in THIS game. Configs are stored per-game (PlaceId), so configs from other games won't appear here.",
    Image = "info",
})
task.spawn(function()
    task.wait(1)
    if not canFile or not isfile(AUTOLOAD_FILE) then return end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(AUTOLOAD_FILE))
    end)
    if ok and type(data) == "table" and data.enabled and data.name then
        SelectedConfig = data.name
        AutoLoadEnabled = true
        if not table.find(ConfigNames, data.name) then
            table.insert(ConfigNames, data.name)
            refreshDropdown()
        end
        pcall(function() ConfigDropdown:Select(data.name) end)
        if loadConfig(data.name) then
            notify("Auto Load", "Loaded config: " .. data.name)
        end
    end
end)
