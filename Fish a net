-- ================= REMOTE HELPERS =================
local function getRemote(name)
    local folder = ReplicatedStorage:FindFirstChild("Remotes")
    return folder and folder:FindFirstChild(name)
end

-- fires or invokes a remote by name, never blocks the caller and never errors
local function send(name, ...)
    local remote = getRemote(name)
    if not remote then return false end
    local args = table.pack(...)
    if remote:IsA("RemoteFunction") then
        task.spawn(function()
            pcall(function()
                remote:InvokeServer(table.unpack(args, 1, args.n))
            end)
        end)
    else
        pcall(function()
            remote:FireServer(table.unpack(args, 1, args.n))
        end)
    end
    return true
end

-- builds a toggle that repeats Run(alive) until it is switched off
local function loopToggle(tab, o)
    local token = 0
    tab:CreateToggle({
        Name = o.Name,
        CurrentValue = false,
        Flag = o.Flag,
        Callback = function(Value)
            token = token + 1
            local myToken = token
            if Value then
                task.spawn(function()
                    local function alive()
                        return token == myToken
                    end
                    while alive() do
                        pcall(o.Run, alive)
                        local wait = o.Interval or 1
                        if type(wait) == "function" then wait = wait() end
                        task.wait(wait)
                    end
                end)
            end
        end,
    })
end

-- sends one remote call per item in the list, with a short gap between them
local function sendEach(alive, remoteName, items, buildArgs, gap)
    for _, item in ipairs(items) do
        if not alive() then break end
        send(remoteName, table.unpack(buildArgs(item)))
        task.wait(gap or 0.15)
    end
end

