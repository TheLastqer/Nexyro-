-- ---- AUTO SHOT ----
local AutoShotBox = Features:AddLeftGroupbox({ Name = "Auto Shot", Icon = "crosshair" })
local autoShotEnabled, autoShotToken = false, 0

AutoShotBox:CreateToggle({
    Name = "Auto Shot", CurrentValue = false, Flag = "AutoShot",
    Callback = function(Value)
        autoShotToken = autoShotToken + 1
        local myToken = autoShotToken
        autoShotEnabled = Value
        if not Value then notify("Auto Shot", "Stopped.", "Info"); return end
        notify("Auto Shot", "Started. Turn OFF to stop.", "Success")

        task.spawn(function()
            while autoShotEnabled and autoShotToken == myToken do
                local ok2, err = pcall(function()
                    local char = Player.Character or Player.CharacterAdded:Wait()
                    local root = char:WaitForChild("HumanoidRootPart", 10)
                    if not root then error("No HumanoidRootPart") end
                    local starterArea = workspace:WaitForChild("StarterArea", 10)
                    local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
                    if not remotes then error("No Remotes folder") end
                    local shot = remotes:WaitForChild("Shot", 10)
                    if not shot then error("No Shot remote") end
                    if not autoShotEnabled or autoShotToken ~= myToken then return end

                    local target = starterArea:IsA("BasePart") and starterArea
                        or starterArea:FindFirstChildWhichIsA("BasePart", true)
                    if target then char:PivotTo(target.CFrame + Vector3.new(0, 3, 0)) end
                    task.wait(0.15)
                    if not autoShotEnabled or autoShotToken ~= myToken then return end

                    shot:WaitForChild("MeterStarted", 10):FireServer()
                    task.wait(0.1)
                    if not autoShotEnabled or autoShotToken ~= myToken then return end
                    shot:WaitForChild("Start", 10):InvokeServer(0.9772802309476661)
                    task.wait(0.1)
                    if not autoShotEnabled or autoShotToken ~= myToken then return end
                    shot:WaitForChild("Complete", 10):InvokeServer({ Skipped = true })
                end)
                if not ok2 then
                    warn("[AutoShot] " .. tostring(err))
                    notify("Auto Shot", "Failed: " .. tostring(err), "Error")
                end
                local w = 0
                while w < 1.0 and autoShotEnabled and autoShotToken == myToken do task.wait(0.1); w = w + 0.1 end
            end
        end)
    end,
})

