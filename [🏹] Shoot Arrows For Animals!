local function findExitButton(gui, titleLabel)
    local titleY = titleLabel.AbsolutePosition.Y
    local best, bestRight = nil, -math.huge
    for _, d in ipairs(gui:GetDescendants()) do
        if (d:IsA("ImageButton") or d:IsA("TextButton")) and d.Visible then
            local sz = d.AbsoluteSize
            if sz.X >= 10 and sz.X <= 55 and math.abs(sz.X - sz.Y) <= 15 then
                if math.abs(d.AbsolutePosition.Y - titleY) <= 40 then
                    local rightEdge = d.AbsolutePosition.X + sz.X
                    if rightEdge > bestRight then best, bestRight = d, rightEdge end
                end
            end
        end
    end
    return best
end

local function getWindowFrame(gui, titleLabel)
    local node = titleLabel
    while node and node.Parent and node.Parent ~= gui do
        node = node.Parent
    end
    return node
end

local function applyBackgroundColor(color)
    local gui, titleLabel = findAirflowScreenGui()
    if not gui or not titleLabel then return end
    local winFrame = getWindowFrame(gui, titleLabel)
    if winFrame and winFrame:IsA("GuiObject") then
        winFrame.BackgroundColor3 = color
        local parent = winFrame.Parent
        if parent and parent:IsA("Frame") and parent.BackgroundTransparency < 1 then
            parent.BackgroundColor3 = color
        end
    end
end

local function createTopPopup(gui, anchorBtn, items, onSelect, title)
    local existing = gui:FindFirstChild("NexyroPopup")
    if existing then existing:Destroy() end

    local absPos = anchorBtn.AbsolutePosition
    local absSize = anchorBtn.AbsoluteSize
    local popupWidth = 200
    local popupHeight = math.min(#items * 32 + 46, 320)
    local screenSize = gui.AbsoluteSize
    local x = math.max(8, math.min(absPos.X + absSize.X - popupWidth, screenSize.X - popupWidth - 8))
    local y = math.min(absPos.Y + absSize.Y + 4, screenSize.Y - popupHeight - 8)

    local popup = Instance.new("Frame")
    popup.Name = "NexyroPopup"
    popup.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
    popup.BorderSizePixel = 0
    popup.Position = UDim2.new(0, x, 0, y)
    popup.Size = UDim2.new(0, popupWidth, 0, popupHeight)
    popup.ZIndex = 2000
    popup.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8); corner.Parent = popup

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(60, 60, 75); stroke.Thickness = 1; stroke.Parent = popup

    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size = UDim2.new(1, -20, 0, 28)
    titleLbl.Position = UDim2.new(0, 10, 0, 8)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = title or "Select"
    titleLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextSize = 14
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.ZIndex = 2001
    titleLbl.Parent = popup

    local scroller = Instance.new("ScrollingFrame")
    scroller.Size = UDim2.new(1, -20, 1, -48)
    scroller.Position = UDim2.new(0, 10, 0, 40)
    scroller.BackgroundTransparency = 1
    scroller.BorderSizePixel = 0
    scroller.ScrollBarThickness = 3
    scroller.ScrollBarImageColor3 = Color3.fromRGB(100, 100, 120)
    scroller.CanvasSize = UDim2.new(0, 0, 0, #items * 32)
    scroller.ZIndex = 2001
    scroller.Parent = popup

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 4)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = scroller

    for i, item in ipairs(items) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 28)
        btn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Text = "        " .. (item.Name or "")
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 13
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.BorderSizePixel = 0
        btn.LayoutOrder = i
        btn.ZIndex = 2002
        btn.AutoButtonColor = true

        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 5); btnCorner.Parent = btn

        local swatch = Instance.new("Frame")
        swatch.Size = UDim2.new(0, 16, 0, 16)
        swatch.Position = UDim2.new(0, 8, 0.5, -8)
        swatch.BackgroundColor3 = item.Color
        swatch.BorderSizePixel = 0
        swatch.ZIndex = 2003
        local swCorner = Instance.new("UICorner")
        swCorner.CornerRadius = UDim.new(0, 3); swCorner.Parent = swatch
        swatch.Parent = btn

        btn.MouseButton1Click:Connect(function()
            onSelect(item)
            popup:Destroy()
        end)
        btn.Parent = scroller
    end

    task.delay(10, function()
        if popup and popup.Parent then popup:Destroy() end
    end)
end

local function injectTopBarControls()
    local gui, titleLabel = findAirflowScreenGui()
    if not gui or not titleLabel then return end
    local exitBtn = findExitButton(gui, titleLabel)
    if not exitBtn then return end
    local bar = exitBtn.Parent
    if not bar then return end
    if bar:FindFirstChild("NexyroControls") then return end

    local container = Instance.new("Frame")
    container.Name = "NexyroControls"
    container.BackgroundTransparency = 1
    container.AnchorPoint = Vector2.new(1, 0.5)

    local exPos, exSize, exAnchor = exitBtn.Position, exitBtn.Size, exitBtn.AnchorPoint
    if exAnchor.X >= 0.5 then
        container.Position = UDim2.new(exPos.X.Scale, exPos.X.Offset - exSize.X.Offset - 8, exPos.Y.Scale, exPos.Y.Offset)
    else
        container.Position = UDim2.new(exPos.X.Scale, exPos.X.Offset - 50, exPos.Y.Scale, exPos.Y.Offset)
    end
    container.Size = UDim2.new(0, 42, 0, math.max(exSize.Y.Offset, 24))
    container.ZIndex = 999
    container.Parent = bar

    local colorBtn = Instance.new("TextButton")
    colorBtn.Name = "ColorBtn"
    colorBtn.Size = UDim2.new(0, 38, 1, 0)
    colorBtn.Position = UDim2.new(0, 0, 0, 0)
    colorBtn.BackgroundColor3 = currentBgColor
    colorBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    colorBtn.Text = "BG"
    colorBtn.Font = Enum.Font.GothamBold
    colorBtn.TextSize = 14
    colorBtn.BorderSizePixel = 0
    colorBtn.ZIndex = 1000
    colorBtn.AutoButtonColor = true
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6); c.Parent = colorBtn
    colorBtn.Parent = container

    colorBtn.MouseButton1Click:Connect(function()
        local popup = gui:FindFirstChild("NexyroPopup")
        if popup then popup:Destroy(); return end
        createTopPopup(gui, colorBtn, COLOR_PRESETS, function(item)
            currentBgColor = item.Color
            colorBtn.BackgroundColor3 = item.Color
            applyBackgroundColor(item.Color)
            notify("Background", "Color: " .. item.Name, "Success")
        end, "Select Background")
    end)
end

task.spawn(function()
    for _ = 1, 20 do
        task.wait(0.5)
        pcall(injectTopBarControls)
        local gui = findAirflowScreenGui()
        if gui and gui:FindFirstChild("NexyroControls", true) then break end
    end
end)
task.spawn(function()
    while true do
        task.wait(5)
        pcall(injectTopBarControls)
    end
end)

