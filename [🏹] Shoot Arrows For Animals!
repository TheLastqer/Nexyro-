-- Fly
local FlyBox = PlayerTab:AddLeftGroupbox({ Name = "Fly", Icon = "plane" })
local flyConnection, flyVelocity, flyGyro
local function stopFly()
    if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
    if flyVelocity then flyVelocity:Destroy(); flyVelocity = nil end
    if flyGyro then flyGyro:Destroy(); flyGyro = nil end
    local hum = getHumanoid(); if hum then hum.PlatformStand = false end
end
local function startFly()
    stopFly()
    flyConnection = RunService.RenderStepped:Connect(function()
        local root = getRoot(); local hum = getHumanoid(); local camera = workspace.CurrentCamera
        if not root or not hum or not camera then return end
        if not flyVelocity or flyVelocity.Parent ~= root then
            if flyVelocity then flyVelocity:Destroy() end
            flyVelocity = Instance.new("BodyVelocity")
            flyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
            flyVelocity.Velocity = Vector3.zero
            flyVelocity.Parent = root
        end
        if not flyGyro or flyGyro.Parent ~= root then
            if flyGyro then flyGyro:Destroy() end
            flyGyro = Instance.new("BodyGyro")
            flyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
            flyGyro.P = 9e4
            flyGyro.Parent = root
        end
        hum.PlatformStand = true
        flyGyro.CFrame = camera.CFrame
        local dir = Vector3.zero
        local move = hum.MoveDirection
        if move.Magnitude > 0 then
            local rel = camera.CFrame:VectorToObjectSpace(move)
            dir = dir + camera.CFrame.RightVector * rel.X + camera.CFrame.LookVector * (-rel.Z)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0, 1, 0) end
        flyVelocity.Velocity = dir.Magnitude > 0 and (dir.Unit * Settings.FlySpeed) or Vector3.zero
    end)
end
FlyBox:CreateSlider({
    Name = "Fly Speed", Range = { 1, 250 }, Increment = 1,
    CurrentValue = Settings.FlySpeed, Flag = "FlySpeed",
    Callback = function(Value) Settings.FlySpeed = Value end,
})
FlyBox:CreateToggle({
    Name = "Enable Fly", CurrentValue = false, Flag = "FlyEnabled",
    Callback = function(Value)
        Settings.FlyEnabled = Value
        if Value then startFly() else stopFly() end
    end,
})
Player.CharacterAdded:Connect(function()
    task.wait(1)
    if Settings.FlyEnabled then startFly() end
end)

-- Server controls
local ServerBox = PlayerTab:AddRightGroupbox({ Name = "Server", Icon = "server" })
local function rejoinServer()
    notify("Rejoin", "Rejoining server...")
    if #Players:GetPlayers() <= 1 then
        Player:Kick("\nRejoining...")
        task.wait()
        TeleportService:Teleport(game.PlaceId, Player)
    else
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, Player)
    end
end
local function hopServer()
    notify("Server Hop", "Searching for a new server...")
    local okR, r = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(
            "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
    end)
    if not okR or not r or not r.data then
        notify("Server Hop", "Could not fetch the server list.", "Error"); return false
    end
    local cands = {}
    for _, s in ipairs(r.data) do
        if s.id ~= game.JobId and s.playing and s.maxPlayers and s.playing < s.maxPlayers then
            table.insert(cands, s.id)
        end
    end
    if #cands == 0 then notify("Server Hop", "No other servers found.", "Warning"); return false end
    TeleportService:TeleportToPlaceInstance(game.PlaceId, cands[math.random(1, #cands)], Player)
    return true
end

ServerBox:CreateButton({ Name = "Rejoin Server", Icon = "refresh-cw", Callback = rejoinServer })
ServerBox:CreateButton({ Name = "Server Hop",    Icon = "shuffle",    Callback = hopServer   })

local hopToken = 0
ServerBox:CreateSlider({
    Name = "Auto Hop Interval", Range = { 30, 600 }, Increment = 5, Suffix = " s",
    CurrentValue = Settings.HopInterval, Flag = "HopInterval",
    Callback = function(Value) Settings.HopInterval = Value end,
})
ServerBox:CreateToggle({
    Name = "Auto Server Hop", CurrentValue = false, Flag = "AutoHop",
    Callback = function(Value)
        Settings.AutoHop = Value
        hopToken = hopToken + 1
        if not Value then return end
        local myToken = hopToken
        task.spawn(function()
            while Settings.AutoHop and hopToken == myToken do
                local rem = Settings.HopInterval
                while rem > 0 and Settings.AutoHop and hopToken == myToken do
                    task.wait(1); rem = rem - 1
                end
                if Settings.AutoHop and hopToken == myToken then hopServer(); task.wait(10) end
            end
        end)
    end,
})
ServerBox:CreateToggle({
    Name = "Auto Rejoin (on disconnect)", CurrentValue = false, Flag = "AutoRejoin",
    Callback = function(Value) Settings.AutoRejoin = Value end,
})
pcall(function()
    local overlay = CoreGui:WaitForChild("RobloxPromptGui"):WaitForChild("promptOverlay")
