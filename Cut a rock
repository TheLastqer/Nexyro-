local function getPromptPos(prompt)
    local parent = prompt.Parent
    if not parent then return nil end
    if parent:IsA("BasePart") then return parent.Position
    elseif parent:IsA("Attachment") then return parent.WorldPosition
    elseif parent:IsA("Model") then return parent:GetPivot().Position end
    local model = parent:FindFirstAncestorWhichIsA("Model")
    if model then return model:GetPivot().Position end
    return nil
end

local function getRoomPos(room)
    if room:IsA("Model") then return room:GetPivot().Position end
    if room:IsA("BasePart") then return room.Position end
    local part = room:FindFirstChildWhichIsA("BasePart", true)
    if part then return part.Position end
    return nil
end

local function getSpawnPos()
    local folder = workspace:FindFirstChild("SpawnAlani")
    local spawnPart = folder and folder:FindFirstChild("SpawnLocation")
    if spawnPart and spawnPart:IsA("BasePart") then
        return spawnPart.Position + Vector3.new(0, SPAWN_HEIGHT, 0)
    end
    return nil
end

local function promptAlive(prompt)
    return prompt and prompt.Parent and prompt:IsDescendantOf(workspace) and prompt.Enabled
end

-- finds the closest enabled prompt inside the selected room only
local function findRoomPrompt()
    local rooms = workspace:FindFirstChild("Rooms")
    if not rooms then return nil end
    local room = rooms:FindFirstChild(getTargetRoom())
    if not room then return nil end
    local container = room:FindFirstChild("Rocks") or room

    local root = getRoot()
    local best, bestDist = nil, math.huge
    for _, inst in ipairs(container:GetDescendants()) do
        if inst:IsA("ProximityPrompt") and inst.Name == PROMPT_NAME and inst.Enabled then
            local pos = getPromptPos(inst)
            if pos then
                local dist = root and (root.Position - pos).Magnitude or 0
                if dist < bestDist then
                    best, bestDist = inst, dist
                end
            end
        end
    end
    return best
end

local function triggerPrompt(prompt)
    pcall(function() prompt.HoldDuration = 0 end)
    pcall(function() prompt.RequiresLineOfSight = false end)
    if typeof(fireproximityprompt) == "function" then
        pcall(fireproximityprompt, prompt)
    else
        pcall(function()
            prompt:InputHoldBegin()
            task.wait(0.05)
            prompt:InputHoldEnd()
        end)
    end
end

local function parseCount(text)
    text = tostring(text):gsub("<[^>]+>", "")
    local cur, max = text:match("(%d+)%s*/%s*(%d+)")
    if cur and max then return tonumber(cur), tonumber(max) end
end

local function getCepBar()
    local ok, bar = pcall(function() return Player.PlayerGui.MainHUD.CepBar end)
    if ok then return bar end
    return nil
end

local function isCepFull()
    local bar = getCepBar()
    if not bar then return false end
    local function check(obj)
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            local cur, max = parseCount(obj.Text)
            if cur and max and max > 0 then return cur >= max end
            local t = obj.Text:lower()
            if t:find("full", 1, true) or t:find("max", 1, true) then return true end
        end
        return nil
    end
    local r = check(bar)
    if r ~= nil then return r end
    for _, d in ipairs(bar:GetDescendants()) do
        local res = check(d)
        if res ~= nil then return res end
    end
    for _, d in ipairs(bar:GetDescendants()) do
        if d:IsA("Frame") and (d.Name:lower():find("fill") or d.Name:lower():find("bar")) then
            if d.Size.X.Scale >= 0.99 then return true end
        end
    end
    return false
end

local function fireRemote(value)
    pcall(function()
        local event = ReplicatedStorage:FindFirstChild("RebornEvent")
        if event then event:FireServer(value) end
    end)
end

local function teleportTo(target)
    local character = Player.Character
    if not character then return false end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    pcall(function()
        character:PivotTo(CFrame.new(target))
    end)
    return true
end

local function startFarm()
    farmToken = farmToken + 1
    local myToken = farmToken
    collected = 0
    lastMinePos = nil
    task.spawn(function()
        local function active()
            return Settings.FarmEnabled and farmToken == myToken
        end

        local function returnToRock()
            local waitChar = 0
            while active() and not getRoot() and waitChar < 10 do
                task.wait(0.25)
                waitChar = waitChar + 0.25
            end
            task.wait(0.5)
            if active() and lastMinePos then
                teleportTo(lastMinePos)
            end
        end

        while active() do
            local target = math.max(1, math.floor(tonumber(Settings.CollectCount) or 1))

            if isCepFull() then
                -- bag full: send back to spawn
                local tries = 0
                while active() and isCepFull() and tries < 20 do
                    fireRemote(true)
                    tries = tries + 1
                    task.wait(0.5)
                end
                collected = 0
                returnToRock()

            elseif collected >= target then
                -- reached the typed amount: teleport to spawn, then return to the rocks
                local spawnPos = getSpawnPos()
                if spawnPos then
                    teleportTo(spawnPos)
                else
                    notify("Auto Farm", "SpawnLocation not found in workspace.SpawnAlani.")
                end
                task.wait(0.5)
                fireRemote(false)
                collected = 0
                task.wait(0.5)
                returnToRock()

            else
                local root = getRoot()
                if not root then
                    task.wait(0.5)
                else
                    local prompt = findRoomPrompt()

                    if not prompt then
                        local rooms = workspace:FindFirstChild("Rooms")
                        local room = rooms and rooms:FindFirstChild(getTargetRoom())
                        if room then
                            local rpos = getRoomPos(room)
                            if rpos and (root.Position - rpos).Magnitude > 30 then
                                teleportTo(rpos + Vector3.new(0, HEIGHT_OFFSET, 0))
                            end
                        end
                        if os.clock() - lastDebug > 15 then
                            lastDebug = os.clock()
                            notify("Auto Farm", "Waiting for rocks in " .. tostring(Settings.FarmRoom) .. " (" .. getTargetRoom() .. ")...")
                        end
                        task.wait(1)
                    else
                        local promptPos = getPromptPos(prompt)
                        if promptPos then
                            local dest = promptPos + Vector3.new(0, HEIGHT_OFFSET, 0)
                            lastMinePos = dest
                            teleportTo(dest)
                            task.wait(0.2)

                            local waited = 0
                            local triggered = false
                            while active() and promptAlive(prompt) and not isCepFull() and waited < MAX_STAY do
                                triggerPrompt(prompt)
                                triggered = true
                                task.wait(FIRE_DELAY)
                                waited = waited + FIRE_DELAY
                            end
                            if triggered and not promptAlive(prompt) then
                                collected = collected + 1
                            end
                        else
                            task.wait(0.5)
                        end
                    end
                end
            end
            task.wait()
        end
    end)
end

