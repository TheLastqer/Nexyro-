        if Settings.AutoRejoin and child.Name == "ErrorPrompt" then
            task.wait(2)
            rejoinServer()
        end
    end)
end)

-- ================= CONFIG TAB (per-game) =================
local ConfigTab = Window:Tab({Title = "Config", Icon = "settings"})
Window:Divider()
local ROOT_FOLDER = "SoulWarden"
local GAME_ID = tostring(game.PlaceId)
local FOLDER = ROOT_FOLDER .. "/" .. GAME_ID
local AUTOLOAD_FILE = FOLDER .. "/autoload.json"
local canFile = typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfile) == "function"
if canFile and typeof(isfolder) == "function" and typeof(makefolder) == "function" then
    if not isfolder(ROOT_FOLDER) then pcall(makefolder, ROOT_FOLDER) end
    if not isfolder(FOLDER) then pcall(makefolder, FOLDER) end
end
local ConfigNames = {}
local SelectedConfig = nil
local TypedName = ""
local AutoLoadEnabled = false
local function cleanName(name)
    name = tostring(name or "")
    name = name:gsub("[^%w_%-% ]", "")
    name = name:match("^%s*(.-)%s*$")
    return name
end
local function configPath(name) return FOLDER .. "/" .. name .. ".json" end
if canFile and typeof(listfiles) == "function" then
    pcall(function()
        for _, path in ipairs(listfiles(FOLDER)) do
            local name = path:match("([^/\\]+)%.json$")
            if name and name ~= "autoload" and not table.find(ConfigNames, name) then
                table.insert(ConfigNames, name)
            end
        end
    end)
end
table.sort(ConfigNames)
local ConfigDropdown
local function refreshDropdown()
    table.sort(ConfigNames)
    pcall(function() ConfigDropdown:Refresh(ConfigNames) end)
end
local function saveAutoLoad()
    if not canFile then return end
    pcall(function()
        writefile(AUTOLOAD_FILE, HttpService:JSONEncode({enabled = AutoLoadEnabled, name = SelectedConfig}))
    end)
end
local function saveConfig(name)
    if not canFile then
        notify("Config", "Your executor does not support file saving.")
        return false
    end
    return pcall(function()
        writefile(configPath(name), HttpService:JSONEncode(Settings))
    end)
end
local function loadConfig(name)
    if not canFile or not isfile(configPath(name)) then
        notify("Config", "Config not found: " .. tostring(name))
        return false
    end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(configPath(name)))
    end)
    if not ok or type(data) ~= "table" then
        notify("Config", "Failed to read config.")
        return false
    end
    local order = {
        "WalkSpeed", "FlySpeed", "HopInterval", "CollectCount", "FarmRoom",
        "AutoBuyEyesight", "AutoBuyPocket", "AutoBuyPickaxe",
        "WalkSpeedEnabled", "FlyEnabled", "AutoHop", "AutoRejoin", "FarmEnabled",
    }
    for _, key in ipairs(order) do
        local value = data[key]
        if value ~= nil and Appliers[key] then
            Appliers[key](value)
            local set = pcall(function() Elements[key]:Set(value) end)
            if not set then
                pcall(function() Elements[key]:Select(value) end)
            end
        end
    end
    return true
end
ConfigTab:Section({Title = "CREATE CONFIG"})
ConfigTab:Input({
    Title = "Config Name",
    Placeholder = "Type a name (example: X)",
    Value = "",
    Callback = function(text) TypedName = text end,
})
ConfigTab:Button({
    Title = "Submit",
    Callback = function()
        local name = cleanName(TypedName)
        if name == "" then
            notify("Config", "Type a config name first.")
            return
        end
        if not table.find(ConfigNames, name) then
            table.insert(ConfigNames, name)
        end
        SelectedConfig = name
        saveConfig(name)
        refreshDropdown()
        pcall(function() ConfigDropdown:Select(name) end)
        notify("Config", "Created config: " .. name)
    end,
})
ConfigTab:Section({Title = "MANAGE CONFIGS"})
ConfigDropdown = ConfigTab:Dropdown({
    Title = "Select Config",
    Values = ConfigNames,
    Value = ConfigNames[1],
    Callback = function(value)
        SelectedConfig = value
        if AutoLoadEnabled then saveAutoLoad() end
    end,
})
ConfigTab:Button({
    Title = "Save Config",
    Callback = function()
        if not SelectedConfig then
            notify("Config", "Select or create a config first.")
            return
        end
        if saveConfig(SelectedConfig) then
            notify("Config", "Saved: " .. SelectedConfig)
        end
    end,
})
ConfigTab:Button({
    Title = "Load Config",
    Callback = function()
        if not SelectedConfig then
            notify("Config", "Select a config first.")
            return
        end
        if loadConfig(SelectedConfig) then
            notify("Config", "Loaded: " .. SelectedConfig)
        end
    end,
})
ConfigTab:Button({
    Title = "Delete Config",
    Callback = function()
        if not SelectedConfig then
            notify("Config", "Select a config first.")
            return
        end
        local name = SelectedConfig
        pcall(function()
            if typeof(delfile) == "function" and isfile(configPath(name)) then
                delfile(configPath(name))
            end
        end)
        local index = table.find(ConfigNames, name)
        if index then table.remove(ConfigNames, index) end
        SelectedConfig = nil
        refreshDropdown()
        notify("Config", "Deleted: " .. name)
    end,
})
ConfigTab:Section({Title = "AUTO LOAD"})
ConfigTab:Toggle({
    Title = "Auto Load Config",
    Default = false,
    Callback = function(value)
        AutoLoadEnabled = value
        saveAutoLoad()
    end,
})
ConfigTab:Paragraph({
    Title = "Auto Load",
    Desc = "When enabled, the selected config loads automatically the next time you run the script in THIS game.",
    Image = "info",
})
task.spawn(function()
    task.wait(1)
    if not canFile or not isfile(AUTOLOAD_FILE) then return end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(AUTOLOAD_FILE))
    end)
    if ok and type(data) == "table" and data.enabled and data.name then
        SelectedConfig = data.name
        AutoLoadEnabled = true
        if not table.find(ConfigNames, data.name) then
            table.insert(ConfigNames, data.name)
            refreshDropdown()
        end
        pcall(function() ConfigDropdown:Select(data.name) end)
        if loadConfig(data.name) then
            notify("Auto Load", "Loaded config: " .. data.name)
        end
    end
end)
