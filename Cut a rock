local function injectTopBarControls()
    local gui, titleLabel = findAirflowScreenGui()
    if not gui or not titleLabel then return end
    local exitBtn = findExitButton(gui, titleLabel)
    if not exitBtn then return end
    local bar = exitBtn.Parent
    if not bar then return end
    if bar:FindFirstChild("NexyroControls") then return end

    local container = Instance.new("Frame")
    container.Name = "NexyroControls"
    container.BackgroundTransparency = 1
    container.AnchorPoint = Vector2.new(1, 0.5)

    local exPos, exSize, exAnchor = exitBtn.Position, exitBtn.Size, exitBtn.AnchorPoint
    if exAnchor.X >= 0.5 then
        container.Position = UDim2.new(exPos.X.Scale, exPos.X.Offset - exSize.X.Offset - 8, exPos.Y.Scale, exPos.Y.Offset)
    else
        container.Position = UDim2.new(exPos.X.Scale, exPos.X.Offset - 50, exPos.Y.Scale, exPos.Y.Offset)
    end
    container.Size = UDim2.new(0, 42, 0, math.max(exSize.Y.Offset, 24))
    container.ZIndex = 999
    container.Parent = bar

    local colorBtn = Instance.new("TextButton")
    colorBtn.Name = "ColorBtn"
    colorBtn.Size = UDim2.new(0, 38, 1, 0)
    colorBtn.Position = UDim2.new(0, 0, 0, 0)
    colorBtn.BackgroundColor3 = currentBgColor
    colorBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    colorBtn.Text = "BG"
    colorBtn.Font = Enum.Font.GothamBold
    colorBtn.TextSize = 14
    colorBtn.BorderSizePixel = 0
    colorBtn.ZIndex = 1000
    colorBtn.AutoButtonColor = true
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6); c.Parent = colorBtn
    colorBtn.Parent = container

    colorBtn.MouseButton1Click:Connect(function()
        local popup = gui:FindFirstChild("NexyroPopup")
        if popup then popup:Destroy(); return end
        createTopPopup(gui, colorBtn, COLOR_PRESETS, function(item)
            currentBgColor = item.Color
            colorBtn.BackgroundColor3 = item.Color
            applyBackgroundColor(item.Color)
            notify("Background", "Color: " .. item.Name, "Success")
        end, "Select Background")
    end)
end

