    end
end
local function hopServer()
    notify("Server Hop", "Searching for a new server...")
    local ok, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
    end)
    if not ok or not result or not result.data then
        notify("Server Hop", "Could not fetch the server list.")
        return false
    end
    local candidates = {}
    for _, server in ipairs(result.data) do
        if server.id ~= game.JobId and server.playing and server.maxPlayers and server.playing < server.maxPlayers then
            table.insert(candidates, server.id)
        end
    end
    if #candidates == 0 then
        notify("Server Hop", "No other servers found.")
        return false
    end
    TeleportService:TeleportToPlaceInstance(game.PlaceId, candidates[math.random(1, #candidates)], Player)
    return true
end
