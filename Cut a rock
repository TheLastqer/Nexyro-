        swatch.Position = UDim2.new(0, 8, 0.5, -8)
        swatch.BackgroundColor3 = item.Color
        swatch.BorderSizePixel = 0
        swatch.ZIndex = 2003
        local swCorner = Instance.new("UICorner")
