local function fetchDiscordStats()
    local ok, response = pcall(function()
        return game:HttpGet("https://discord.com/api/v9/invites/" .. DISCORD_CODE .. "?with_counts=true&with_expiration=true")
    end)
    if not ok or not response or type(response) ~= "string" or #response < 4 then
        discordStats.Total = "Unavailable"
        discordStats.Online = "Unavailable"
        discordStats.Offline = "Unavailable"
        return
    end
    local decoded
    local decodeOk = pcall(function() decoded = HttpService:JSONDecode(response) end)
    if not decodeOk or not decoded or not decoded.approximate_member_count then
        discordStats.Total = "Unavailable"
        discordStats.Online = "Unavailable"
        discordStats.Offline = "Unavailable"
        return
    end
    local total = tonumber(decoded.approximate_member_count) or 0
    local online = tonumber(decoded.approximate_presence_count) or 0
    discordStats.Total = tostring(total)
    discordStats.Online = tostring(online)
    discordStats.Offline = tostring(math.max(0, total - online))
    discordStats.Available = true
    discordStats.LastRefresh = os.clock()
end

