local function findExitButton(gui, titleLabel)
    local titleY = titleLabel.AbsolutePosition.Y
    local best, bestRight = nil, -math.huge
    for _, d in ipairs(gui:GetDescendants()) do
        if (d:IsA("ImageButton") or d:IsA("TextButton")) and d.Visible then
            local sz = d.AbsoluteSize
            if sz.X >= 10 and sz.X <= 55 and math.abs(sz.X - sz.Y) <= 15 then
                if math.abs(d.AbsolutePosition.Y - titleY) <= 40 then
                    local rightEdge = d.AbsolutePosition.X + sz.X
                    if rightEdge > bestRight then best, bestRight = d, rightEdge end
                end
            end
        end
    end
    return best
end

local function getWindowFrame(gui, titleLabel)
    local node = titleLabel
    while node and node.Parent and node.Parent ~= gui do
        node = node.Parent
    end
    return node
end

local function applyBackgroundColor(color)
    local gui, titleLabel = findAirflowScreenGui()
    if not gui or not titleLabel then return end
    local winFrame = getWindowFrame(gui, titleLabel)
    if winFrame and winFrame:IsA("GuiObject") then
        winFrame.BackgroundColor3 = color
        local parent = winFrame.Parent
        if parent and parent:IsA("Frame") and parent.BackgroundTransparency < 1 then
            parent.BackgroundColor3 = color
        end
    end
end

local function createTopPopup(gui, anchorBtn, items, onSelect, title)
    local existing = gui:FindFirstChild("NexyroPopup")
    if existing then existing:Destroy() end

    local absPos = anchorBtn.AbsolutePosition
    local absSize = anchorBtn.AbsoluteSize
    local popupWidth = 200
    local popupHeight = math.min(#items * 32 + 46, 320)
    local screenSize = gui.AbsoluteSize
    local x = math.max(8, math.min(absPos.X + absSize.X - popupWidth, screenSize.X - popupWidth - 8))
    local y = math.min(absPos.Y + absSize.Y + 4, screenSize.Y - popupHeight - 8)

    local popup = Instance.new("Frame")
    popup.Name = "NexyroPopup"
    popup.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
    popup.BorderSizePixel = 0
    popup.Position = UDim2.new(0, x, 0, y)
